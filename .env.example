# Copie este arquivo para .env e ajuste os valores.
# O .env não vai para o repositório (contém senhas e chaves).

# --- Django (os dois serviços) ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-propria
# Chave que assina os JWT. Precisa ser IGUAL nos dois serviços:
# o Serviço de Chat valida o token emitido pelo Serviço de Autenticação.
JWT_SIGNING_KEY=troque-por-outra-chave-longa

# --- Banco de dados ---
# Sem DB_HOST, cada serviço usa SQLite (desenvolvimento local sem Docker).
# No docker-compose, DB_HOST=postgres é definido automaticamente.
DB_USER=chat
DB_PASSWORD=Senha@Forte123
# Porta do PostgreSQL na máquina (DBeaver, pgAdmin)
DB_PORT_HOST=5433

# --- Docker ---
WEB_PORT=8080
AUTH_REPLICAS=2
CHAT_REPLICAS=2

# --- MongoDB ---
MONGO_USER=chat_admin
MONGO_PASSWORD=MongoSenha123
MONGO_URL=mongodb://chat_admin:MongoSenha123@mongo:27017/?authSource=admin
MONGO_DB_NAME=chat_messages